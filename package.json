{
  "name": "@containerbase/istanbul-reports-html",
  "version": "0.0.0-semantic-release",
  "keywords": [
    "coverage",
    "highlight",
    "highlight.js",
    "istanbul",
    "jest",
    "reports",
    "syntax",
    "vitest"
  ],
  "license": "MIT",
  "author": "Michael Kriese <michael.kriese@visualon.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/containerbase/istanbul-reports.git"
  },
  "files": [
    "dist/",
    "vendor/",
    "index.cjs"
  ],
  "type": "module",
  "main": "index.cjs",
  "scripts": {
    "build": "node tools/build.js",
    "lint": "run-s oxfmt oxlint",
    "lint-fix": "run-s oxfmt-fix oxlint-fix",
    "lint:types": "run-p 'lint:types:*'",
